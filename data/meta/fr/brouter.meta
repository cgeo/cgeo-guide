BRouter est un moteur de calcul d’itinéraires intégré à c:geo. Il fournit des trajets guidés, calculés hors ligne, entre deux coordonnées à partir des données d’OpenStreetMap.
Si la navigation est activée, c:geo peut l’utiliser pour remplacer la ligne droite habituelle affichée sur la carte entre votre position et la cible de navigation (c’est‑à‑dire une cache ou un waypoint) par un itinéraire routé, comme illustré dans la comparaison ci‑dessous.…";}s:8:"relation";a:3:{s:5:"media";a:4:{s:18:"helper_brouter.png";b:1;s:22:"en:brouter_without.png";b:1;s:19:"en:brouter_with.png";b:1;s:30:"en:brouter_individualroute.png";b:1;}s:10:"references";a:3:{s:20:"fr:mainmenu:settings";b:1;s:19:"fr:mainmenu:livemap";b:1;s:19:"en:mainmenu:livemap";b:1;}s:10:"firstimage";s:18:"helper_brouter.png";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1772649015;s:8:"modified";i:1772651614;}s:7:"creator";s:14:"Pascal Héraud";s:4:"user";s:8:"alranapa";s:11:"last_change";a:9:{s:4:"date";i:1772651614;s:2:"ip";s:39:"fe80:3508:7b71:35f5:fbff:5386:32f1:5154";s:4:"type";s:1:"E";s:2:"id";s:10:"fr:brouter";s:4:"user";s:8:"alranapa";s:3:"sum";s:20:"Fin de traduction FR";s:5:"extra";s:0:"";s:10:"sizechange";i:-159;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:8:"alranapa";s:14:"Pascal Héraud";}}}