Cette page décrit la procédure permettant de transférer toutes vos données c:geo d’un appareil à un autre. Cela peut être utile, par exemple, si vous avez un nouvel appareil et souhaitez transférer toutes les caches enregistrées ainsi que vos paramètres de l’ancien vers le nouvel appareil.";}s:8:"relation";a:2:{s:10:"references";a:3:{s:20:"fr:mainmenu:settings";b:1;s:15:"fr:installation";b:1;s:13:"fr:firststeps";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1772651657;s:8:"modified";i:1772652308;}s:7:"creator";s:14:"Pascal Héraud";s:4:"user";s:8:"alranapa";s:11:"last_change";a:9:{s:4:"date";i:1772652308;s:2:"ip";s:39:"fe80:3508:7b71:35f5:fbff:5386:32f1:5154";s:4:"type";s:1:"E";s:2:"id";s:16:"fr:replacedevice";s:4:"user";s:8:"alranapa";s:3:"sum";s:17:"Fin traduction FR";s:5:"extra";s:0:"";s:10:"sizechange";i:-159;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:8:"alranapa";s:14:"Pascal Héraud";}}}